# GitHub token with repo/PR access
GITHUB_TOKEN=
# Repo under review, owner/repo — GitHub CI sets this automatically
GITHUB_REPOSITORY=

# --- LLM config (agents/llm.py) --------------------------------------------
# One value to switch providers: google | openai | claude ("anthropic" is an
# accepted alias of claude). Keep all three key pairs below filled in and
# flipping MODEL_PROVIDER is the only change needed — locally and in CI
# (GitHub: set it as a repo *variable*; keys as repo *secrets*).
# Model defaults come from docs/llm-providers.md if the *_MODEL var is empty.
MODEL_PROVIDER=google

# Google (default provider)
GOOGLE_API_KEY=
GOOGLE_MODEL=

# OpenAI — used when MODEL_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=

# Claude — used when MODEL_PROVIDER=claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=

# --- Legacy (pre-provider) config -------------------------------------------
# Still honored when MODEL_PROVIDER is unset: AI_API_KEY plus MODEL_NAME as a
# "provider:model" string for langchain's init_chat_model. Prefer the scheme
# above; kept so older CI secrets keep working.
AI_API_KEY=
MODEL_NAME=

# GitHub token with repo/PR access
GITHUB_TOKEN=
# Repo under review, owner/repo — GitHub CI sets this automatically
GITHUB_REPOSITORY=
# LLM API key for the reviewer agent (Step 4+) — in CI this comes from the
# repo's Actions secret, never from a file
AI_API_KEY=
# provider:model string for langchain's init_chat_model — see docs/llm-providers.md.
# Defaults to the free-tier google_genai:gemini-3.8-flash if unset.
MODEL_NAME=

# --- Local-only vars (GitHub Actions sets both automatically) --------------
# GITHUB_TOKEN: locally `gh auth token`; in CI the workflow injects
# secrets.GITHUB_TOKEN (scoped to the repo under review).
GITHUB_TOKEN=
# GITHUB_REPOSITORY: repo under review as owner/repo; in CI the workflow
# injects github.repository (the CALLING repo for the reusable workflow).
GITHUB_REPOSITORY=

# --- LLM config (agents/llm.py) --------------------------------------------
# One value to switch providers: google | openai | claude. Keep all three
# key pairs below filled in and flipping MODEL_PROVIDER is the only change
# needed — locally and in CI (GitHub: set it as a repo *variable*; keys as
# repo *secrets*). Required: if unset the run logs an error and exits.
# Model defaults come from docs/llm-providers.md if the *_MODEL var is empty.
MODEL_PROVIDER=google

# Google (default provider)
GOOGLE_API_KEY=
GOOGLE_MODEL=

# OpenAI — used when MODEL_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=

# Claude — used when MODEL_PROVIDER=claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=

# --- Logging ---------------------------------------------------------------
# DEBUG shows every debug log — ours (pr-reviewer.*) and libraries' (httpx,
# openai, langchain, PyGithub, …). Empty → INFO. In CI: set as a repo
# *variable*.
LOG_LEVEL=
